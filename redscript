@replaceMethod(MenuHubGameController)
public func HandlePlayerWeightUpdated(opt dropQueueWeight: Float)
{
	let carryCurrent: Float = this.m_player.m_curInventoryWeight;
	let carryCapacity: Int32 = (Cast<Int32>(GameInstance.GetStatsSystem(this.m_player.GetGame()).GetStatValue(Cast<StatsObjectID>(this.m_player.GetEntityID()), gamedataStatType.CarryCapacity)));
	if(dropQueueWeight < 0.0) {
		this.m_dropWeight = 0.0;
	} else {
		if(dropQueueWeight > 0.0) {
			this.m_dropWeight = dropQueueWeight;
		}
		carryCurrent -= this.m_dropWeight;
	}
	this.m_subMenuCtrl.HandlePlayerWeightUpdated(carryCurrent, carryCapacity);
}

